# PostgreSQL database (Prisma Postgres) — create one at https://prisma.io
# Credentials are NEVER committed; copy this file to .env and fill in real values.
DATABASE_URL=postgresql://user:password@localhost:5432/empresaplana?pgbouncer=true&connect_timeout=15&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/empresaplana?connect_timeout=15&sslmode=require
AUTH_SECRET=

# Google Sheets sync (service account JSON path + spreadsheet id)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
