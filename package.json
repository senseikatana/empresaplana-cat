{
  "name": "empresaplana",
  "version": "0.1.0",
  "description": "Proyecto empresaplana — dos stacks en paralelo: Astro y Nuxt",
  "type": "module",
  "scripts": {
    "install:astro": "cd withastro && bun install",
    "install:nuxt": "cd withnuxt && pnpm install",
    "install": "pnpm run install:astro && pnpm run install:nuxt",
    "dev:astro": "cd withastro && bun run dev",
    "dev:nuxt": "cd withnuxt && pnpm run dev",
    "dev": "cd withastro && bun run dev & cd withnuxt && pnpm run dev; wait",
    "tunnel:astro": "cd withastro && bun run tunnel",
    "tunnel:nuxt": "cd withnuxt && pnpm run tunnel",
    "build:astro": "cd withastro && bun run build",
    "build:nuxt": "cd withnuxt && pnpm run build",
    "build": "pnpm run build:astro && pnpm run build:nuxt",
    "preview:astro": "cd withastro && bun run preview",
    "preview:nuxt": "cd withnuxt && pnpm run preview",
    "check:astro": "cd withastro && bunx astro check",
    "check:nuxt": "cd withnuxt && pnpm run check",
    "check": "pnpm run check:astro && pnpm run check:nuxt",
    "db:setup:astro": "cd withastro && bun run db:setup",
    "db:setup:nuxt": "cd withnuxt && pnpm run db:setup",
    "db:push:astro": "cd withastro && bun run db:push",
    "db:push:nuxt": "cd withnuxt && pnpm run db:push",
    "db:generate:astro": "cd withastro && bun run db:generate",
    "db:generate:nuxt": "cd withnuxt && pnpm run db:generate",
    "db:studio:nuxt": "cd withnuxt && pnpm run db:studio"
  },
  "author": "senseikatana - Sergio Jurado",
  "license": "MIT"
}
