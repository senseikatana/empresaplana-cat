{
	"name": "empresaplana-intranet",
	"type": "module",
	"version": "2.0.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint .",
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"db:setup": "pnpm run db:generate && pnpm run db:push && pnpm run db:seed",
		"db:demo": "tsx scripts/database/demo-crud.ts",
		"postinstall": "prisma generate"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "^16.3.5",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@types/mdx": "^2.0.14",
		"dotenv": "^17.4.2",
		"jose": "^6.2.12",
		"katanakit-js": "^3.2.2",
		"next": "^15.5.25",
		"next-intl": "^4.14.5",
		"pg": "^8.23.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.5.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"prisma": "^7.10.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3"
	},
	"author": "Sergio Jurado - @senseikatana",
	"description": "Empresa Plana intranet — Next.js App Router + Prisma"
}
