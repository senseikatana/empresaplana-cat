# Neon Postgres — pooled for app runtime, unpooled for Prisma CLI (migrations)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Auth secret for JWT sessions (jose HS256)
AUTH_SECRET="change-me-to-a-random-string"

# Optional: bus tracking data file
BUS_TRACKING_DATA_FILE=".data/bus-tracking.json"
