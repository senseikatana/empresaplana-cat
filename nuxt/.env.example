# Prisma Postgres connection string
# Get yours from: https://console.prisma.io
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth secret for JWT sessions (used by src/lib/auth.ts)
AUTH_SECRET="change-me-to-a-random-string"

# Google Sheets sync (optional)
# Service account JSON credentials (paste the whole JSON as a single line)
GOOGLE_SHEETS_CREDENTIALS=""
# Spreadsheet ID from the Google Sheets URL
GOOGLE_SHEETS_SPREADSHEET_ID=""

# Bus tracking data file (optional, defaults to .data/bus-tracking.json)
BUS_TRACKING_DATA_FILE=".data/bus-tracking.json"
